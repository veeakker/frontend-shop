{{outlet}}
<div class="login">
  <div class="checkout-contact">
    <div class="contact-info">

      <h1 class="tab-title">inloggen</h1>

      <Design::Forks @useDarkImage={{true}}/>

      <div class="error-message">
        {{#if this.error}}
          {{this.error}}
        {{/if}}
      </div>

      <div class="form-field">
        <label for="login-email">E-mail</label>
        <Input id="login-email" @type="email" @value={{this.email}} />
      </div>
      <div class="form-field">
        <label for="login-password">Wachtwoord</label>
        <Input id="login-password" @type="password" @value={{this.password}} />
      </div>

      <div class="button-product-cart"><a {{on 'click' this.login}} href="#">Inloggen</a></div>
      <div class="button-product-cart"><LinkTo @route="webshop.register" @query={{hash afterLoginRoute=this.afterLoginRoute afterLoginModel=this.afterLoginModel}}>Registreer</LinkTo></div>
    </div>
  </div>
</div>
{{outlet}}
