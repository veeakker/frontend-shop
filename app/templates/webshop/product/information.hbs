{{!-- template-lint-disable no-triple-curlies --}}
<div class="prose-content">
  {{{this.model.description}}}
</div>

{{#if (or (and this.model.targetUnit.unit this.model.targetUnit.value) (and this.model.unitPrice.value this.model.unitPrice.unit) this.model.plu)}}
  <dl class="general-product-information">
    {{#if (and this.model.targetUnit.unit this.model.targetUnit.value)}}
      <dt>Richtgewicht</dt>
      <dd>{{this.model.targetUnit.value}}{{human-unit this.model.targetUnit.unit}} per stuk</dd>
    {{/if}}
    {{#if (and this.model.unitPrice.value this.model.unitPrice.unit)}}
      <dt>Eenheidsprijs</dt>
      <dd>€{{this.model.unitPrice.value}} per {{human-unit this.model.unitPrice.unit}}</dd>
    {{/if}}
    {{#if this.model.plu}}
      <dt>PLU</dt>
      <dd>{{this.model.plu}}</dd>
    {{/if}}
  </dl>
{{/if}}
{{outlet}}
