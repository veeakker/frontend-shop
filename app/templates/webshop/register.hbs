{{outlet}}
<div class="login">
  <div class="checkout-contact">
    <div class="contact-info">
      <h1 class="tab-title">Registreer</h1>
      <Design::Forks @useDarkImage={{true}}/>
      <div class="error-message">
        <ul>
          {{#each this.errors as |error|}}
            <li>{{error.title}}</li>
          {{/each}}
        </ul>
      </div>

      <div class="form-field">
        <label for="reg-email">E-mail</label>
        <Input id="reg-email" required @type="email" @value={{this.email}} />
      </div>
      <div class="form-field">
        <label for="reg-password">Wachtwoord</label>
        <Input id="reg-password" required @type="password" @value={{this.password}} />
      </div>

      <hr />

      <div class="form-row">
        <div class="form-field">
          <label for="reg-firstname">Voornaam</label>
          <Input id="reg-firstname" required @type="text" @value={{this.firstName}} />
        </div>
        <div class="form-field">
          <label for="reg-lastname">Achternaam</label>
          <Input id="reg-lastname" required @type="text" @value={{this.lastName}} />
        </div>
      </div>
      <div class="form-field">
        <label for="reg-address">Straat + huisnummer</label>
        <Input id="reg-address" required @type="text" @value={{this.address}} />
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="reg-postal">Postcode</label>
          <Input id="reg-postal" required @type="text" @value={{this.postalCode}} />
        </div>
        <div class="form-field">
          <label for="reg-city">Gemeente</label>
          <Input id="reg-city" required @type="text" @value={{this.locality}} />
        </div>
      </div>
      <div class="form-field">
        <label for="reg-phone">Telefoonnummer</label>
        <Input id="reg-phone" required @type="text" @value={{this.telephone}} />
      </div>

      <div class="button-product-cart"><button type="button" class="button" {{on "click" this.register}}>Registreer</button></div>
      <div class="button-product-cart"><LinkTo @route="login" @query={{hash afterLoginRoute=this.afterLoginRoute afterLoginModel=this.afterLoginModel}}>Inloggen</LinkTo></div>
    </div>
  </div>
</div>
{{outlet}}
