<Webshop::CheckoutProgress @currentStep="finish" />

<div class="checkout-contact finish-page">
  <div class="contact-info">

    <div class="finish-banner">
      <span class="finish-banner__icon">&#x2713;</span>
      <strong>Bestelling geplaatst</strong>
    </div>

    <div class="finish-section">
      <span class="finish-section__label">Levering</span>
      {{#if (eq this.basket.deliveryType "http://veeakker.be/delivery-methods/postal")}}
        <p>Thuislevering</p>
        {{#if this.basket.hasCustomDeliveryPlace}}
          {{#let this.basket.deliveryAddress as |address|}}
            <p class="finish-section__sub">
              {{address.firstName}} {{address.lastName}}<br/>
              {{address.postalAddress.streetAddress}}<br/>
              {{address.postalAddress.postalCode}} {{address.postalAddress.locality}}
            </p>
          {{/let}}
        {{/if}}
        <p class="finish-section__sub">
          Indien besteld voor zondag middernacht:<br/>
          Regio Leuven: geleverd zaterdag voormiddag<br/>
          Andere locaties: geleverd zaterdag doorheen de dag, tenzij anders afgesproken
        </p>
      {{else if (eq this.basket.deliveryType "http://veeakker.be/delivery-methods/tour")}}
        <p>Toer Veeakker</p>
        <p class="finish-section__sub">Voor de eerstkomende levering, indien besteld voor zondag middernacht</p>
        {{#let this.basket.deliveryPlace as |place|}}
          <p class="finish-section__sub">
            {{place.label}}<br/>
            {{place.postalAddress.streetAddress}}<br/>
            {{place.postalAddress.postalCode}} {{place.postalAddress.locality}}
          </p>
        {{/let}}
      {{else if (eq this.basket.deliveryType "http://veeakker.be/delivery-methods/shop")}}
        <p>Afhalen in bioshop</p>
        <p class="finish-section__sub">Indien besteld voor zondag middernacht beschikbaar op vrijdag vanaf 17u00 of zaterdag</p>
        {{#let this.basket.deliveryPlace as |place|}}
          <p class="finish-section__sub">
            {{place.label}}<br/>
            {{place.postalAddress.streetAddress}}<br/>
            {{place.postalAddress.postalCode}} {{place.postalAddress.locality}}
          </p>
        {{/let}}
      {{/if}}
    </div>

    <div class="finish-section">
      <span class="finish-section__label">Contactgegevens</span>
      {{#if this.basket.customer.id}}
        {{#let this.basket.customer as |customer|}}
          <p>
            {{customer.firstName}} {{customer.lastName}}<br/>
            {{customer.postalAddress.streetAddress}}<br/>
            {{customer.postalAddress.postalCode}} {{customer.postalAddress.locality}}<br/>
            {{customer.email}}
          </p>
        {{/let}}
      {{else}}
        {{#let this.basket.invoiceAddress as |address|}}
          <p>
            {{#if address.company}}{{address.company}}<br/>{{/if}}
            {{address.firstName}} {{address.lastName}}<br/>
            {{address.postalAddress.streetAddress}}<br/>
            {{address.postalAddress.postalCode}} {{address.postalAddress.locality}}
          </p>
        {{/let}}
      {{/if}}
    </div>

    <div class="frost-div">
      <img class="frost" src="/images/vries.png" alt="Frozen icon" width="25" />
      <p>Zorg voor een diepvries indien je diepgevroren producten bestelt!</p>
    </div>

  </div>
</div>

<div class="order">
  <h2>Bestelde producten</h2>
  {{#if this.basket.orderLines}}
    <div class="basket-card">
      <Webshop::OrderLines @orderLines={{this.basket.orderLines}} />
      <div class="cart-total">
        <p class="cart-price">Totaalprijs <span class="money">{{euros this.totalCost}}</span></p>
        <p class="cart-message">Bedankt voor je bestelling!</p>
      </div>
    </div>
  {{/if}}
</div>

<div class="finish-upsell">
  {{#let (or (and (eq this.basket.deliveryType "http://veeakker.be/delivery-methods/tour") (or this.basket.deliveryPlace.lfwLink this.basket.deliveryPlace.deliveryRoute.lfwLink)) "https://localfoodworks.eu/bestellen/market/9") as |lfwLink|}}
    <p>
      <strong>Andere producten rechtstreeks van de boer?</strong><br/>
      Bestel ze op <a href={{lfwLink}}>Local Food Works</a> en we leveren ze samen.
      Selecteer de markt in overeenstemming met je leverdatum.
    </p>
  {{/let}}
</div>

{{outlet}}
