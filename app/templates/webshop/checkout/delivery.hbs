<Webshop::CheckoutProgress @currentStep="delivery" />

<div class="delivery-contact">
  <div class="contact-info">
    <h2>Kies je levermethode</h2>
    <LinkTo @route="collection-points" id="extra-info">Meer info over leveringen en afhaalpunten</LinkTo>

    <div class="delivery-methods">
      <Webshop::Checkout::Delivery::MethodCard
        @id="postal"
        @current={{this.deliveryMethod}}
        @icon="🏠"
        @title="Thuislevering regio Leuven"
        @description="Wekelijkse levering op zaterdag voormiddag"
        @detail="Bij bestelling onder €150 kan €25 leveringskost aangerekend worden"
        @price="Zie voorwaarden"
      />
      <Webshop::Checkout::Delivery::MethodCard
        @id="shop"
        @current={{this.deliveryMethod}}
        @icon="🌿"
        @title="Afhalen in natuurvoedingswinkel"
        @description="Kies je afhaallocatie op de kaart"
        @detail="Vrij te kiezen uit onze partnerswinkels"
        @price="Gratis"
      />
      <Webshop::Checkout::Delivery::MethodCard
        @id="tour"
        @current={{this.deliveryMethod}}
        @icon="📍"
        @title="Afhaalpunt op Toer Veeakker"
        @description="Kies je afhaalpunt langs de route"
        @detail="Mobiel afhaalpunt, telkens op een vaste dag"
        @price="Gratis"
      />
    </div>

    {{#if (eq this.deliveryMethod "postal")}}
      <Webshop::Checkout::Delivery::Checkbox @for={{true}} @current={{this.basket.basket.hasCustomDeliveryPlace}}>
        Leveren op een andere locatie
      </Webshop::Checkout::Delivery::Checkbox>
    {{/if}}

    {{#if (eq this.deliveryMethod "tour")}}
      <div class="delivery-map">
        <Webshop::Checkout::Delivery::LocationsMap
          @locationName="tour"
          @select={{this.basket.setDeliveryPlace}}
          @baseZoom={{if this.basket.basket.deliveryPlace 12 9}}
          @baseLat={{this.basket.basket.deliveryPlace.geoCoordinate.latitude}}
          @baseLng={{this.basket.basket.deliveryPlace.geoCoordinate.longitude}}
        />
      </div>
    {{/if}}

    {{#if (eq this.deliveryMethod "shop")}}
      <div class="delivery-map">
        <Webshop::Checkout::Delivery::LocationsMap
          @locationName="shop"
          @select={{this.basket.setDeliveryPlace}}
          @baseZoom={{if this.basket.basket.deliveryPlace 12 9}}
          @baseLat={{this.basket.basket.deliveryPlace.geoCoordinate.latitude}}
          @baseLng={{this.basket.basket.deliveryPlace.geoCoordinate.longitude}}
        />
      </div>
    {{/if}}

    {{#if (and this.basket.basket.deliveryPlace (or (eq this.deliveryMethod "shop") (eq this.deliveryMethod "tour")))}}
      {{#let this.basket.basket.deliveryPlace as |deliveryPlace|}}
        <div class="delivery-place">
          <h4>Geselecteerde afhaalpunt</h4>
          <p>
            {{deliveryPlace.label}} <br />
            {{deliveryPlace.postalAddress.streetAddress}} <br/>
            {{deliveryPlace.postalAddress.postalCode}} {{deliveryPlace.postalAddress.locality}}
          </p>
        </div>
      {{/let}}
    {{/if}}

    {{#if (eq this.deliveryMethod "postal")}}
      {{#if this.basket.basket.hasCustomDeliveryPlace}}
        <div class="contact-info-different">
          <h2>Lever adres</h2>
          <div class="form-row">
            <div class="form-field">
              <label for="delivery-firstname">Voornaam</label>
              <Input id="delivery-firstname" @value={{mut this.basket.basket.delivery.firstName}} />
            </div>
            <div class="form-field">
              <label for="delivery-lastname">Achternaam</label>
              <Input id="delivery-lastname" @value={{mut this.basket.basket.delivery.lastName}} />
            </div>
          </div>
          <div class="form-field">
            <label for="delivery-company">Bedrijf + BTW nummer</label>
            <Input id="delivery-company" @value={{mut this.basket.basket.delivery.company}} placeholder="Optioneel" />
          </div>
          <div class="form-field">
            <label for="delivery-street">Straat + huisnummer</label>
            <Input id="delivery-street" @value={{mut this.basket.basket.delivery.address.streetAddress}} />
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="delivery-postal">Postcode</label>
              <Input id="delivery-postal" @value={{mut this.basket.basket.delivery.address.postalCode}} />
            </div>
            <div class="form-field">
              <label for="delivery-city">Gemeente</label>
              <Input id="delivery-city" @value={{mut this.basket.basket.delivery.address.locality}} />
            </div>
          </div>
          <div class="form-field">
            <label for="delivery-phone">GSM / Tel</label>
            <Input id="delivery-phone" @value={{mut this.basket.basket.delivery.telephone}} placeholder="Bereikbaar bij levering" />
          </div>
          <div class="form-field">
            <label for="delivery-email">E-mailadres</label>
            <Input id="delivery-email" @value={{mut this.basket.basket.delivery.email}} />
          </div>
        </div>
      {{/if}}
    {{/if}}

    <div class="cart-total">
      <p class="cart-price">Totaalprijs <span class="money">{{euros this.basket.totalPrice}}</span></p>

      {{#if this.basket.hasUnavailableOrderLines}}
        <div class="checkout-notice">
          <p>Je mandje bevat producten die niet beschikbaar zijn op de gekozen locatie.</p>
          <LinkTo @route="webshop.basket" class="btn-warning">Bekijk winkelmandje</LinkTo>
        </div>
      {{else if (not this.canConfirmBasket)}}
        {{#if (eq this.checkoutRequirements.firstUnsatisfiedStep this.checkoutRequirements.basketStep)}}
          <div class="checkout-notice">
            <p>Vul je winkelmandje aan om verder te gaan.</p>
            <LinkTo @route="webshop.basket" class="btn-warning">Naar winkelmandje</LinkTo>
          </div>
        {{else if (eq this.checkoutRequirements.firstUnsatisfiedStep this.checkoutRequirements.identityStep)}}
          <div class="checkout-notice">
            <p>Vul je contactgegevens in om verder te gaan.</p>
            <LinkTo @route="webshop.checkout.contact-info" class="btn-warning">Naar contactgegevens</LinkTo>
          </div>
        {{else if (eq this.checkoutRequirements.firstUnsatisfiedStep this.checkoutRequirements.deliveryStep)}}
          <div class="checkout-notice">
            <p>Kies je levermethode om verder te gaan.</p>
            <LinkTo @route="webshop.checkout.delivery" class="btn-warning">Naar levering</LinkTo>
          </div>
        {{/if}}
      {{/if}}

      {{#unless this.basket.hasUnavailableOrderLines}}
        <div class="button-product-cart">
          <button type="button" disabled={{not this.canConfirmBasket}} {{on "click" (fn this.confirmOrder)}}>Bevestigen</button>
        </div>
      {{/unless}}
    </div>
  </div>
</div>

{{outlet}}
