{{outlet}}

<Webshop::CheckoutProgress @currentStep="payment" />
<div class="fix"></div>

<div class="checkout-contact">
  <div class="contact-info">
    {{#if this.deliveredOntour}}
      <h2 class="deliveryMessage">
        Je bestelling is cash of met bankcontact te betalen bij afhaling.<br /> <br />
        Het totaalbedrag bij de afsluitende stap is slechts een indicatie van het bedrag.
        Het effectieve totaalbedrag kan hier van afwijken.
      </h2>
    {{else}}
      <iframe title="Payment provider" src={{this.paymentUrl}} width="800" height="600" />
    {{/if}}

    <a href={{this.paymentUrl}}>Open</a>

    <br />

    <div class="cart-total">
      <p>Prijs <span class="money">{{euros this.basket.totalPrice}}</span></p>
      <p>Prijs levering: <span class="money">gratis</span></p>
      <p>BTW 6% <span class="money">€x</span></p>
      <p>Totaalprijs <span class="money">€x</span></p>    <br />
      <div class="button-product-cart uppercase"><a href={{this.paymentUrl}}>betaal</a></div>
    </div><div class="fix"></div>

  </div>
</div>
{{outlet}}
