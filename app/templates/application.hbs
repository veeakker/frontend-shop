{{page-title (or this.shop.label (if this.goedgekozenEnabled "goedgekozen.be" "Veeakker"))}}
{{#if this.goedgekozenEnabled}}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='18' fill='none' stroke='%232F7D44' stroke-width='3'/%3E%3Cpath d='M11 20.5 L17 26.5 L29 13.5' fill='none' stroke='%232F7D44' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <meta name="description" content="goedgekozen.be — een plek van zorgvuldig uitgekozen winkels en makers. Samen besteld, afgehaald bij jou om de hoek. Korte ketens, eerlijke economie, minimale impact.">
{{/if}}
<style>{{this.shop.style}}</style>
<div id="page-container" vocab="https://schema.org/" typeof="Store" resource="http://veeakker.be/" data-brand={{this.brand}} data-shop={{this.shop.slug}}>
  <TopMenu />
  <div id="content-wrap">
      {{outlet}}
  </div>

  {{#if this.goedgekozenEnabled}}
    <footer class="ggz-footer">
      <div class="ggz-footer__brand">
        <svg class="ggz-footer__mark" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <path d="M11 20.5 L17 26.5 L29 13.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="ggz-footer__wordmark">goedgekozen<span class="ggz-footer__be">.be</span></span>
      </div>
      <div class="ggz-footer__links">
        <LinkTo @route="collection-points">Levering &amp; afhaling</LinkTo>
        <LinkTo @route="conditions">Algemene voorwaarden</LinkTo>
        <LinkTo @route="faq">Veelgestelde vragen</LinkTo>
        <LinkTo @route="contact-us">Contact</LinkTo>
      </div>
      <p class="ggz-footer__tagline">Lokaal gekozen. Korte keten. Eerlijke economie.</p>
    </footer>
  {{else}}
    <footer>
      <LinkTo @route="collection-points">levering &amp; afhaling</LinkTo>
      <LinkTo @route="conditions">algemene voorwaarden</LinkTo>
      <LinkTo @route="contact-us">contact info</LinkTo>
    </footer>
  {{/if}}
</div>
