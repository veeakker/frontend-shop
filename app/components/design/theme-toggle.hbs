<button
  type="button"
  class="theme-toggle{{if (eq @variant "mobile") " theme-toggle--mobile"}}"
  title={{if (eq @variant "mobile") null (if (eq this.theme.effectiveTheme "dark") "Schakel naar lichtmodus" "Schakel naar donkermodus")}}
  {{on "click" this.theme.toggle}}
>
  {{#if (eq this.theme.effectiveTheme "dark")}}
    <svg
      width={{if (eq @variant "mobile") "16" "18"}}
      height={{if (eq @variant "mobile") "16" "18"}}
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <circle cx="9" cy="9" r="3.5" />
      <line x1="9" y1="1" x2="9" y2="2.5" />
      <line x1="9" y1="15.5" x2="9" y2="17" />
      <line x1="1" y1="9" x2="2.5" y2="9" />
      <line x1="15.5" y1="9" x2="17" y2="9" />
      <line x1="3.7" y1="3.7" x2="4.8" y2="4.8" />
      <line x1="13.2" y1="13.2" x2="14.3" y2="14.3" />
      <line x1="14.3" y1="3.7" x2="13.2" y2="4.8" />
      <line x1="4.8" y1="13.2" x2="3.7" y2="14.3" />
    </svg>
    {{#if (eq @variant "mobile")}}Lichtmodus{{/if}}
  {{else}}
    <svg
      width={{if (eq @variant "mobile") "16" "18"}}
      height={{if (eq @variant "mobile") "16" "18"}}
      viewBox="0 0 18 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M14.5 11A6.5 6.5 0 0 1 7 3.5a6.5 6.5 0 1 0 7.5 7.5z" />
    </svg>
    {{#if (eq @variant "mobile")}}Donkermodus{{/if}}
  {{/if}}
</button>
