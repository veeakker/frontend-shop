<div class="product-card {{this.detailClass}}{{if this.basketCount " product-card--in-basket"}}">
  {{#if this.basketCount}}
    <span class="basket-fold-badge" aria-hidden="true">
      <span class="basket-fold-badge__count">{{this.basketCount}}</span>
    </span>
  {{/if}}
  <div
    class={{concat "picture-info" (if @product.isEnabled "" " product-disabled")}}
    {{action (mut this.showDetail) (not this.showDetail)}}
    role="button">

    <div class="picture">
      <ProductCard::Thumbnail @product={{@product}} />
    </div>
    <div class="icons">
      {{#each @product.enabledLabelArray as |label|}}
        <span class="icon icon-2"><img src={{label.image}} alt={{concat label.label "icon"}}/></span>
      {{/each}}
    </div>
  </div>

  <div class="description">
    <div class="product-title">{{#if @product}}{{@product.label}}{{else}}Kotelet{{/if}}</div>
    {{#if (and @product.altLabel (not (eq @product.altLabel "")))}}
      <div class="alternative-terms">{{@product.altLabel}}</div>
    {{/if}}
    {{#if (and this.supplier (not (eq this.supplier.name "")))}}
      <div class="alternative-terms">{{this.supplier.name}}</div>
    {{/if}}
  </div>

  {{#if @product.isEnabled}}
    <Webshop::OrderLineManager
      @product={{@product}}
      @selectedOffer={{this.selectedOffer}}
      @amount={{this.packageCount}}
      @onChange={{this.updateConfiguration}}
      @onDefault={{this.updateConfiguration}}
      as |configuration|>
      <div class="amounts">
        <div class="configuration">
          <div class="per-pakje">
            Per pakje:
            <div class="per-pakje-input">
              <div style="display: none">
                {{!-- rendering possible offers off screen ensures Offers gets updated as needed --}}
                {{#each configuration.offers as |offer|}}({{offer.typeAndQuantity.value}}{{offer.typeAndQuantity.unit}}){{/each}}
              </div>
              <ProductCard::Offers @offers={{configuration.offers}} @onChange={{configuration.selectOffer}} @selected={{this.selectedOffer}} />
              {{#if @product.offerings}}
                <div class="eenheid">
                  <select class="select-eenheid" name="units" onchange={{pick "target.value" configuration.selectUnit}} disabled={{if (sub configuration.units.length 1) "" "disabled"}}>
                    {{#each configuration.units as |unit|}}
                      <option selected={{eq unit configuration.selectedUnit}} value={{unit}}>{{unit}}</option>
                    {{/each}}
                  </select>
                </div>
              {{/if}}
            </div>
          </div>

          <div class="pakjes">
            Pakjes: <NumberButton @value={{this.packageCount}} @onChange={{action (mut this.packageCount)}} />
          </div>
        </div>

        <ProductCard::PackagesImage @count={{this.packageCount}} @offer={{configuration.selectedOffer}} />
      </div>
      <div class="teste">
        <p>Totaal {{euros (mult configuration.selectedOffer.unitPrice.value this.packageCount)}}</p>

      </div>

      <div class="actions">
        <button class="button-product" type="button" {{on "click" this.add}}>Bestel</button>
        <LinkTo class="button-product" @route="webshop.product" @model={{@product}}>Meer...</LinkTo>
      </div>
    </Webshop::OrderLineManager>
  {{else}}
    <div class="product-not-available">
      Dit product is momenteel niet beschikbaar
    </div>
    <div class="actions">
      <div class="button-product"><LinkTo @route="webshop.product" @model={{@product}}>Meer...</LinkTo></div>
    </div>
  {{/if}}
</div>
