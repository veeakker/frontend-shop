{{#if this.goedgekozenEnabled}}
  {{#if this.onShopPage}}
    <Design::TopMenuShell
      @wrapperClass="ggz-shop-header"
      @wrapperStyle={{if this.shopHeader.topImageUrl (concat "background-image: url('" this.shopHeader.topImageUrl "')")}}
      @mobileOpen={{this.mobileOpen}}
      @mobileOpenClass={{this.mobileIsOpenClass}}
      @onOpenNav={{this.openNav}}
      @onCloseNav={{this.closeNav}}
    >
      <:logo>
        <LinkTo class="logo-veeakker" @route="webshop" @model={{this.shopHeader.shop}}>
          {{#if this.shopHeader.logoUrl}}
            <img src={{this.shopHeader.logoUrl}} alt={{this.shopHeader.label}} />
          {{else}}
            <span class="brand-text">{{this.shopHeader.label}}</span>
          {{/if}}
        </LinkTo>
      </:logo>
      <:links>
        <LinkTo @route="webshop" @model={{this.shopHeader.shop}}>Webshop</LinkTo>
        <LinkTo @route="locations">Locaties</LinkTo>
        <LinkTo @route="contact-us">Contact</LinkTo>
        <LinkTo @route="index">Andere winkels</LinkTo>
      </:links>
    </Design::TopMenuShell>
  {{else}}
    <Design::TopMenuShell
      @wrapperClass="ggz-top-menu"
      @mobileOpen={{this.mobileOpen}}
      @mobileOpenClass={{this.mobileIsOpenClass}}
      @onOpenNav={{this.openNav}}
      @onCloseNav={{this.closeNav}}
    >
      <:logo>
        <LinkTo class="ggz-top-wordmark" @route="index" aria-label="goedgekozen.be — naar start">
          <svg class="ggz-top-wordmark__mark" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="2.5" />
            <path d="M11 20.5 L17 26.5 L29 13.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="ggz-top-wordmark__text">goedgekozen<span class="ggz-top-wordmark__be">.be</span></span>
        </LinkTo>
      </:logo>
      <:links>
        <LinkTo @route="index">Winkels</LinkTo>
        <LinkTo @route="locations">Locaties</LinkTo>
        <LinkTo @route="contact-us">Contact</LinkTo>
      </:links>
    </Design::TopMenuShell>
  {{/if}}
{{else}}
  <Design::TopMenuShell
    @wrapperStyle={{if this.shopHeader.topImageUrl (concat "background-image: url('" this.shopHeader.topImageUrl "')")}}
    @mobileOpen={{this.mobileOpen}}
    @mobileOpenClass={{this.mobileIsOpenClass}}
    @onOpenNav={{this.openNav}}
    @onCloseNav={{this.closeNav}}
  >
    <:logo>
      {{#if (eq this.logoRoute "webshop")}}
        <LinkTo class="logo-veeakker" @route={{this.logoRoute}} @model={{this.shopHeader.shop}}>
          {{#if this.shopHeader.logoUrl}}
            <img src={{this.shopHeader.logoUrl}} alt={{this.shopHeader.label}} />
          {{else if this.mainSiteEnabled}}
            <img src="/images/veeakker.png" alt="Veeakker brand name in written front" />
          {{else}}
            <span class="brand-text">{{this.shopHeader.label}}</span>
          {{/if}}
        </LinkTo>
      {{else}}
        <LinkTo class="logo-veeakker" @route={{this.logoRoute}}>
          {{#if this.shopHeader.logoUrl}}
            <img src={{this.shopHeader.logoUrl}} alt={{this.shopHeader.label}} />
          {{else if this.mainSiteEnabled}}
            <img src="/images/veeakker.png" alt="Veeakker brand name in written front" />
          {{else}}
            <span class="brand-text">{{this.shopHeader.label}}</span>
          {{/if}}
        </LinkTo>
      {{/if}}
    </:logo>
    <:links>
      <LinkTo @route="webshop" @model={{this.shopHeader.shop}}>Webshop</LinkTo>
      {{#if this.mainSiteEnabled}}
        <LinkTo @route="about">Over ons</LinkTo>
        <LinkTo @route="products">Product info</LinkTo>
      {{/if}}
      <LinkTo @route="locations">Locaties</LinkTo>
      <LinkTo @route="contact-us">Contact</LinkTo>
    </:links>
  </Design::TopMenuShell>
{{/if}}
