<div class="top-menu" style={{if this.topImageUrl (concat "background-image: url('" this.topImageUrl "')")}}>
  <LinkTo class="logo-veeakker" @route={{this.logoRoute}} @model={{this.webshop}}>
    {{#if this.webshop.logo}}
      <img src={{this.webshop.logo.downloadUrl}} alt={{this.webshop.label}} />
    {{else if this.mainSiteEnabled}}
      <img src="/images/veeakker.png" alt="Veeakker brand name in written front" />
    {{else}}
      <span class="brand-text">{{this.webshop.label}}</span>
    {{/if}}
  </LinkTo>

  <div id="veeakker-menu">
    <LinkTo @route="webshop" @model={{this.webshop}}>Webshop</LinkTo>
    {{#if this.mainSiteEnabled}}
      <LinkTo @route="products">Product info</LinkTo>
      <LinkTo @route="about">Over ons</LinkTo>
    {{/if}}
    <!-- <LinkTo @route="news">Nieuws</LinkTo> -->
    <LinkTo @route="locations">Locaties</LinkTo>
    <LinkTo @route="contact-us">Contact</LinkTo>
    <button
      type="button"
      class="theme-toggle"
      title={{if (eq this.theme.effectiveTheme "dark") "Schakel naar lichtmodus" "Schakel naar donkermodus"}}
      {{on "click" this.theme.toggle}}
    >
      {{#if (eq this.theme.effectiveTheme "dark")}}
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="9" cy="9" r="3.5"/>
          <line x1="9" y1="1" x2="9" y2="2.5"/>
          <line x1="9" y1="15.5" x2="9" y2="17"/>
          <line x1="1" y1="9" x2="2.5" y2="9"/>
          <line x1="15.5" y1="9" x2="17" y2="9"/>
          <line x1="3.7" y1="3.7" x2="4.8" y2="4.8"/>
          <line x1="13.2" y1="13.2" x2="14.3" y2="14.3"/>
          <line x1="14.3" y1="3.7" x2="13.2" y2="4.8"/>
          <line x1="4.8" y1="13.2" x2="3.7" y2="14.3"/>
        </svg>
      {{else}}
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 11A6.5 6.5 0 0 1 7 3.5a6.5 6.5 0 1 0 7.5 7.5z"/>
        </svg>
      {{/if}}
    </button>
      {{#if this.mobileIsOpenClass}}
        <a id="mobile-menu" {{on "click" this.closeNav}}>
          <i class="fa fa-times"></i>
        </a>
      {{else}}
        <a id="mobile-menu" {{on "click" this.openNav}}>
          <i class="fa fa-bars"></i>
        </a>
      {{/if}}
  </div>
</div>
<div class="mobile-menu-links {{this.mobileIsOpenClass}}">
  <LinkTo @route="webshop" @model={{this.webshop}}>Webshop</LinkTo>
  {{#if this.mainSiteEnabled}}
    <LinkTo @route="about">Over ons</LinkTo>
    <LinkTo @route="products">Product info</LinkTo>
  {{/if}}
  {{!-- <LinkTo @route="news">Nieuws</LinkTo> --}}
  <LinkTo @route="locations">Locaties</LinkTo>
  <LinkTo @route="contact-us">Contact</LinkTo>
  <button
    type="button"
    class="theme-toggle theme-toggle--mobile"
    {{on "click" this.theme.toggle}}
  >
    {{#if (eq this.theme.effectiveTheme "dark")}}
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="9" cy="9" r="3.5"/>
        <line x1="9" y1="1" x2="9" y2="2.5"/>
        <line x1="9" y1="15.5" x2="9" y2="17"/>
        <line x1="1" y1="9" x2="2.5" y2="9"/>
        <line x1="15.5" y1="9" x2="17" y2="9"/>
        <line x1="3.7" y1="3.7" x2="4.8" y2="4.8"/>
        <line x1="13.2" y1="13.2" x2="14.3" y2="14.3"/>
        <line x1="14.3" y1="3.7" x2="13.2" y2="4.8"/>
        <line x1="4.8" y1="13.2" x2="3.7" y2="14.3"/>
      </svg>
      Lichtmodus
    {{else}}
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 11A6.5 6.5 0 0 1 7 3.5a6.5 6.5 0 1 0 7.5 7.5z"/>
      </svg>
      Donkermodus
    {{/if}}
  </button>
</div>
