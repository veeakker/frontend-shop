<nav class="checkout-progress" aria-label="Checkout stappen">
  {{#each this.steps as |step|}}
    {{#if step.route}}
      <LinkTo class={{step.classNames}} @route={{step.route}}>
        <div class="checkout-progress__circle">{{step.number}}</div>
        <span class="checkout-progress__label">{{step.label}}</span>
      </LinkTo>
    {{else}}
      <div class={{step.classNames}}>
        <div class="checkout-progress__circle">{{step.number}}</div>
        <span class="checkout-progress__label">{{step.label}}</span>
      </div>
    {{/if}}
  {{/each}}
</nav>