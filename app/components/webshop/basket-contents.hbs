<div class="basket-cards">
  {{#if this.disabledOrderLines.length}}
    <Webshop::Basket::Card @warning={{true}} @hasFooter={{true}}>
      <:title>
        <span class="basket-card__header-icon" aria-hidden="true">&#x26A0;</span>
        <h2 class="basket-card__subtitle">Momenteel niet beschikbaar</h2>
      </:title>

      <:body>
        <Webshop::OrderLines
          @orderLines={{this.disabledOrderLines}}
          @removeOrderLine={{@removeOrderLine}} />
      </:body>

      <:footer>
        <div class="basket-card__hint">
          <p>
            Deze producten zijn momenteel niet leverbaar. Verwijder ze om verder te gaan.
          </p>
        </div>
      </:footer>
    </Webshop::Basket::Card>
  {{/if}}

  {{#if this.notAtLocationOrderLines.length}}
    <Webshop::Basket::Card @warning={{true}} @hasFooter={{true}}>
      <:title>
        <span class="basket-card__header-icon" aria-hidden="true">&#x26A0;</span>
        <h2 class="basket-card__subtitle">Producten niet beschikbaar op deze locatie</h2>
      </:title>

      <:body>
        <Webshop::OrderLines
          @orderLines={{this.notAtLocationOrderLines}}
          @removeOrderLine={{@removeOrderLine}} />
      </:body>

      <:footer>
        <div class="basket-card__hint">
          <p>
            Verwijder deze producten om verder te gaan, of kies een andere locatie. Op de afhaallocatie is wellicht een gelijkwaardig alternatief beschikbaar.
          </p>
          <LinkTo @route="webshop.checkout.delivery" class="basket-card__hint-link">Locatie wijzigen</LinkTo>
        </div>
      </:footer>
    </Webshop::Basket::Card>
  {{/if}}

  <Webshop::Basket::Card @hasFooter={{true}}>
    <:title>
      <h2 class="basket-card__subtitle">Je volledige mandje</h2>
    </:title>

    <:body>
      <Webshop::OrderLines
        @orderLines={{@orderLines}}
        @removeOrderLine={{@removeOrderLine}} />
    </:body>

    <:footer>
      <div class="cart-total">
        <p class="cart-price"><span class="money">{{euros @totalPrice}}</span></p>
        <p class="cart-message">Exclusief verzendkosten</p>
        {{#if @hasUnacceptableOrderLines}}
          <p class="cart-total__notice">
            {{#if (and this.disabledOrderLines.length this.notAtLocationOrderLines.length)}}
              Verwijder de producten die niet leverbaar zijn op de huidige locatie of <LinkTo @route="webshop.checkout.delivery">kies een andere locatie</LinkTo>. Verwijder de producten die momenteel niet leverbaar zijn en <LinkTo @route="webshop">kies eventueel een alternatief</LinkTo>.
            {{else if this.disabledOrderLines.length}}
              Verwijder de producten die momenteel niet beschikbaar zijn om verder te gaan.
            {{else}}
              <LinkTo @route="webshop.checkout.delivery">Kies een ander leverpunt</LinkTo> of verwijder de producten die niet beschikbaar zijn op de gekozen locatie om verder te gaan.
            {{/if}}
          </p>
        {{else if @onCheckout}}
          <div class="button-product-cart">
            <LinkTo @route={{@onCheckout}}>{{@onCheckoutLabel}}</LinkTo>
          </div>
        {{/if}}
      </div>
    </:footer>
  </Webshop::Basket::Card>
</div>