{{#each @orderLines as |orderLine|}}
  {{#if (has-block "order-extra")}}
    <Webshop::Basket::Row
      @orderLine={{orderLine}}
      @removeOrderLine={{@removeOrderLine}}
      @plainRows={{@plainRows}}
      @hideAvailabilityWarning={{@hideAvailabilityWarning}}
      @hideDisabledWarning={{@hideDisabledWarning}}
      @confirmRemoval={{@confirmRemoval}}>
      {{!-- TODO: is there a better way to pass this conditionally?--}}
      <:order-extra as |orderLine|>
        {{yield orderLine to="order-extra"}}
      </:order-extra>
    </Webshop::Basket::Row>
  {{else}}
    <Webshop::Basket::Row
      @orderLine={{orderLine}}
      @removeOrderLine={{@removeOrderLine}}
      @plainRows={{@plainRows}}
      @hideAvailabilityWarning={{@hideAvailabilityWarning}}
      @hideDisabledWarning={{@hideDisabledWarning}}
      @confirmRemoval={{@confirmRemoval}} />
  {{/if}}
{{/each}}