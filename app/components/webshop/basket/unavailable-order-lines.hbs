{{#if (or this.unavailableAtLocation.length this.currentlyUnavailable.length)}}
  <div class="unavailable-order-lines">
    {{#if this.unavailableAtLocation.length}}
      <section class="unavailable-section unavailable-at-location">
        <h2 class="unavailable-section-title">
          <i class="fas fa-map-marker-alt"></i>
          Niet beschikbaar op deze locatie
        </h2>
        <p class="unavailable-section-subtitle">
          Deze producten kunnen we niet leveren of afhalen op de gekozen locatie. Op de afhaallocatie is wellicht een gelijkwaardig alternatief beschikbaar.
        </p>
        <ul class="unavailable-list">
          {{#each this.unavailableAtLocation as |orderLine|}}
            <li class="unavailable-item">
              <LinkTo class="unavailable-thumbnail" @route="webshop.product" @model={{orderLine.product}}>
                <ProductCard::Thumbnail @product={{orderLine.offering.typeAndQuantity.product}} />
              </LinkTo>
              <div class="unavailable-item-body">
                <LinkTo class="unavailable-item-title" @route="webshop.product" @model={{orderLine.product}}>
                  {{orderLine.offering.typeAndQuantity.product.label}}
                </LinkTo>
                <span class="unavailable-item-amount">
                  <Webshop::Basket::Amount @amount={{orderLine.offering.typeAndQuantity}} /> <i class="fas fa-times"></i>{{orderLine.amount}} pakje{{#if (gte orderLine.amount 2)}}s{{/if}}
                </span>
              </div>
              {{#if @removeOrderLine}}
                <button class="unavailable-remove-button" type="button" aria-label="Verwijder uit winkelmandje" {{on "click" (fn @removeOrderLine orderLine.offering orderLine.amount)}}>
                  <i class="fas fa-trash"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    {{#if this.currentlyUnavailable.length}}
      <section class="unavailable-section currently-unavailable">
        <h2 class="unavailable-section-title">
          <i class="far fa-clock"></i>
          Tijdelijk niet beschikbaar
        </h2>
        <p class="unavailable-section-subtitle">
          Deze producten zijn momenteel uit voorraad. Verwijder ze om je bestelling af te werken, of probeer het later opnieuw.
        </p>
        <ul class="unavailable-list">
          {{#each this.currentlyUnavailable as |orderLine|}}
            <li class="unavailable-item">
              <LinkTo class="unavailable-thumbnail" @route="webshop.product" @model={{orderLine.product}}>
                <ProductCard::Thumbnail @product={{orderLine.offering.typeAndQuantity.product}} />
              </LinkTo>
              <div class="unavailable-item-body">
                <LinkTo class="unavailable-item-title" @route="webshop.product" @model={{orderLine.product}}>
                  {{orderLine.offering.typeAndQuantity.product.label}}
                </LinkTo>
                <span class="unavailable-item-amount">
                  <Webshop::Basket::Amount @amount={{orderLine.offering.typeAndQuantity}} /> <i class="fas fa-times"></i>{{orderLine.amount}} pakje{{#if (gte orderLine.amount 2)}}s{{/if}}
                </span>
              </div>
              {{#if @removeOrderLine}}
                <button class="unavailable-remove-button" type="button" aria-label="Verwijder uit winkelmandje" {{on "click" (fn @removeOrderLine orderLine.offering orderLine.amount)}}>
                  <i class="fas fa-trash"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}
  </div>
{{/if}}