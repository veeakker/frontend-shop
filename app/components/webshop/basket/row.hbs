<div class={{concat "cart-item"
                    (if (and (not @plainRows) (not (and this.productIsEnabled this.offeringIsEnabled)))
                        " product-disabled" "")
                    (if (and (not @plainRows) (not this.availableForBasketLocation))
                        " not-available-at-location" "")}}
    ...attributes>
  <LinkTo class="cart-thumbnail" @route="webshop.product" @model={{@orderLine.product}}>
    <ProductCard::Thumbnail @product={{@orderLine.offering.typeAndQuantity.product}} />
  </LinkTo>

  <div class="order-info">
    <h3>
      <LinkTo @route="webshop.product" @model={{@orderLine.product}}>
        {{@orderLine.offering.typeAndQuantity.product.label}}
      </LinkTo>
    </h3>
    <h4>
      {{#if this.editing}}
        <span class="order-line-edit">
          <Webshop::OrderLineManager
            @product={{@orderLine.offering.typeAndQuantity.product}}
            @selectedOffer={{this.selectedOffer}}
            @amount={{this.amount}}
            @onChange={{this.updateConfiguration}}
            as |configuration|>
            <select class="order-select" name="quantities" onchange={{pick "target.value" (fn this.pickQuantity configuration.offers)}}>
              {{#each configuration.quantities as |quantity|}}
                <option selected={{eq (get this.selectedOffer "typeAndQuantity.value") quantity}} value={{quantity}}>{{quantity}}</option>
              {{/each}}
            </select>
            <select class="order-select" name="units" onchange={{pick "target.value" configuration.selectUnit}}>
              {{#each configuration.units as |unit|}}
                <option selected={{eq unit configuration.selectedUnit}} value={{unit}}>{{unit}}</option>
              {{/each}}
            </select>
            &times;
            <NumberButton @value={{this.amount}} @onChange={{this.updateAmount}} />
            <span class="order-line-unit-label">pakje{{#if (gte this.amount 2)}}s{{/if}}</span>
          </Webshop::OrderLineManager>
          <span class="order-line-edit-actions">
            <button class="button-product" type="button" {{on "click" this.confirmEditing}}>Bevestig</button>
            <button class="order-line-cancel" type="button" {{on "click" this.cancelEditing}}>Annuleer</button>
          </span>
        </span>
      {{else if @removeOrderLine}}
        <span class="order-line-view" role="button" {{on "click" this.startEditing}}>
          <Webshop::Basket::Amount @amount={{@orderLine.offering.typeAndQuantity}} />
          &times;
          {{@orderLine.amount}} pakje{{#if (gte @orderLine.amount 2)}}s{{/if}}
        </span>
      {{else}}
        <Webshop::Basket::Amount @amount={{@orderLine.offering.typeAndQuantity}} />
        &times;
        {{@orderLine.amount}} pakje{{#if (gte @orderLine.amount 2)}}s{{/if}}
      {{/if}}
    </h4>

    {{#if (and (not @hideDisabledWarning) (or (eq this.productIsEnabled false) (eq this.offeringIsEnabled false)))}}
      <p class="product-disabled-message">&#x26A0; Momenteel niet beschikbaar.</p>
    {{/if}}

    {{#if (and (not @hideAvailabilityWarning) (not this.availableForBasketLocation))}}
      <p class="product-unavailable-message">&#x26A0; Niet beschikbaar op de gekozen locatie.</p>
    {{/if}}

    {{#if @removeOrderLine}}
      <Util::OpenClosed @defaultOpen={{@orderLine.monitoredComment}}>
        <:open>
          <Textarea style="width: 100%" @value={{@orderLine.monitoredComment}} placeholder="Opmerking" />
          {{#if @orderLine.commentChanged}}
            <button class="add-comment-button" type="button" {{on "click" (fn this.persistCommentFn @orderLine)}}>Opslaan</button>
          {{/if}}
        </:open>
        <:closed as |commentHolder|>
          <button class="add-comment-button" type="button" {{on "click" commentHolder.makeOpenFn}}>Voeg opmerking toe</button>
        </:closed>
      </Util::OpenClosed>
    {{else}}
      {{#if @orderLine.monitoredComment}}
        <span class="order-comment">{{@orderLine.monitoredComment}}</span>
      {{/if}}
    {{/if}}
  </div>

  <div class="order-extra">
    {{#if (has-block "order-extra")}}
      {{yield @orderLine to="order-extra"}}
    {{else}}
      <span class="order-price-per-unit">{{euros @orderLine.pricePerUnit}} / pakje</span>
      <span class="order-total-price">{{euros @orderLine.price}}</span>
      {{#if @removeOrderLine}}
        {{#if this.confirmingRemoval}}
          <span class="remove-confirmation" role="status">Verwijderen?</span>
          <div class="remove-confirm-actions">
            <button class="remove-button remove-yes" type="button" {{on "click" (fn @removeOrderLine @orderLine.offering @orderLine.amount)}}>Zeker</button>
            <button class="remove-button remove-no" type="button" {{on "click" this.cancelRemoval}}>Behouden</button>
          </div>
        {{else}}
          <button class="remove-button" type="button" aria-label="Verwijder uit winkelmandje" {{on "click" this.requestRemoval}}>
            <i class="fas fa-trash"></i>
          </button>
        {{/if}}
      {{/if}}
    {{/if}}
  </div>
</div>